# Stocker - Environment Variables
# Copy this file to .env and fill in your keys

# Claude API (required for sentiment analysis and auto-trading AI decisions)
ANTHROPIC_API_KEY=

# Alpaca Broker (required for auto-trading)
# Get keys at https://app.alpaca.markets -> Paper Trading -> API Keys
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Alpha Vantage (optional - alternative data source to yfinance)
# Get a free key at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Discord Webhook (optional - trade notifications)
# Create at: Discord channel settings -> Integrations -> Webhooks
DISCORD_WEBHOOK_URL=
